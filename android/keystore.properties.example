# Release-signing keystore credentials.
#
# Copy this file to `keystore.properties` and fill in your values. The real
# file and the keystore itself are gitignored — never commit them.
#
# Generate the keystore once with:
#   keytool -genkeypair -v -keystore tasquera-release.keystore \
#     -alias tasquera -keyalg RSA -keysize 2048 -validity 10000
#
# Back up both files somewhere offline: losing the keystore means existing
# installs can never be updated with the same signature.

storeFile=tasquera-release.keystore
storePassword=CHANGE_ME
keyAlias=tasquera
keyPassword=CHANGE_ME
